<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.folio.factory</groupId>
    <artifactId>factory-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>factory-flow-cypress</artifactId>
  <name>Factory Cypress Flow</name>
  <description>Cypress E2E Factory plugin: story to TestRail test cases to Cypress specs with HITL reviews</description>

  <dependencies>
    <dependency>
      <groupId>org.folio.factory</groupId>
      <artifactId>factory-agents</artifactId>
    </dependency>
    <!-- Provider-specific chat options (prompt caching). Deliberately declared here and not
         in factory-agents, which stays neutral so FACTORY_LLM_PROVIDER can select OpenAI. -->
    <dependency>
      <groupId>org.springframework.ai</groupId>
      <artifactId>spring-ai-anthropic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.folio.factory</groupId>
      <artifactId>factory-connectors</artifactId>
    </dependency>
    <!-- HTML-to-text extraction for public-page link enrichment (ContextPrefetch). Small,
         self-contained, no transitive bloat - not brought in by anything else in the reactor. -->
    <dependency>
      <groupId>org.jsoup</groupId>
      <artifactId>jsoup</artifactId>
      <version>1.18.1</version>
    </dependency>
    <!-- Builds valid ISO 2709 MARC bytes (leader/directory arithmetic) from the LLM's
         semantic field content for test-data fixture attachments. Self-contained, no
         transitive bloat - not brought in by anything else in the reactor. -->
    <dependency>
      <groupId>org.marc4j</groupId>
      <artifactId>marc4j</artifactId>
      <version>2.9.6</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.folio.factory</groupId>
      <artifactId>factory-agents</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
