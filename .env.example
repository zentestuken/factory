# FOLIO AI SDLC Factory — sample environment.
#
# Copy to .env (git-ignored) and fill in what you need:
#
#   cp .env.example .env
#
# Docker Compose reads .env for interpolation. Spring Boot does not load it
# when started directly; export it into your shell before starting the app:
#
#   set -a; source .env; set +a
#   mvn spring-boot:run -pl factory-app
#
# Every value below is optional and shown at its built-in default, except the
# LLM key. With zero connector credentials the Test Factory flow still runs
# end to end in advisory mode — external syncs are audited as CONNECTOR_SKIPPED.
# Full reference: the configuration table in README.md.

# ---------------------------------------------------------------- LLM provider
# The only setting you normally must supply. Without a key the app boots, warns
# at startup, and LLM-backed steps fail at runtime and escalate to human review.

ANTHROPIC_API_KEY=

# FACTORY_LLM_PROVIDER=anthropic
# FACTORY_LLM_MODEL=claude-sonnet-4-6
# How long to wait for one LLM call before cancelling it (default 300s). A cancelled request is
# still billed for whatever the model already generated, so too tight a value pays for output it
# then discards. The cypress flow does not rely on this - it sets its own 15-minute timeout per
# request (TestCaseGenAgentWorker.chatOptions) because its generation call is far larger.
# FACTORY_LLM_TIMEOUT=300s

# Set FACTORY_LLM_PROVIDER=openai to use any OpenAI-compatible endpoint
# (Groq, Gemini, OpenRouter, local Ollama). ANTHROPIC_API_KEY is then unused.
# FACTORY_LLM_PROVIDER=openai
# FACTORY_LLM_API_KEY=
# FACTORY_LLM_BASE_URL=https://api.groq.com/openai/v1
# FACTORY_LLM_COMPLETIONS_PATH=/chat/completions
# FACTORY_LLM_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------- Database
# Defaults match docker-compose.yml, so `docker compose up -d` needs no change.

# FACTORY_DB_URL=jdbc:postgresql://localhost:5432/factory
# FACTORY_DB_USER=factory
# FACTORY_DB_PASSWORD=factory

# Pool sizing — raise FACTORY_DB_POOL_MAX in lockstep with engine worker-threads.
# See doc/performance.md.
# FACTORY_DB_POOL_MAX=16
# FACTORY_DB_POOL_MIN_IDLE=4
# FACTORY_DB_POOL_CONNECTION_TIMEOUT_MS=30000
# FACTORY_DB_POOL_MAX_LIFETIME_MS=1800000
# FACTORY_DB_POOL_IDLE_TIMEOUT_MS=600000
# FACTORY_DB_POOL_LEAK_DETECTION_MS=60000

# ------------------------------------------------------------------- Webhooks
# /api/webhooks/jira and /api/webhooks/github are UNAUTHENTICATED while this is
# unset (the app warns at startup). Checked against the ?token= query param.
# Always set it outside local development.

# FACTORY_WEBHOOKS_SHARED_SECRET=

# ----------------------------------------------------------------- Connectors
# Each connector activates only when ALL of its variables are set; otherwise the
# step is audited as CONNECTOR_SKIPPED and the flow continues.

# FACTORY_CONNECTORS_JIRA_BASE_URL=
# FACTORY_CONNECTORS_JIRA_EMAIL=
# FACTORY_CONNECTORS_JIRA_API_TOKEN=

# FACTORY_CONNECTORS_GITHUB_TOKEN=
# FACTORY_CONNECTORS_GITHUB_BASE_URL=          # only for GitHub Enterprise

# ----------------------------------------------------- Developer Flow demo
# One runtime selector. Each runtime has its own independent profile.
# Inactive profiles may be empty. Credentials are copied only for a coding attempt.
# FACTORY_DEV_FACTORY_CODING_RUNTIME=pi

# Pi 0.85.1: minimal OpenAI-compatible profile.
# FACTORY_PI_IMAGE=factory-dev-pi:0.85.1-java21-node22
# FACTORY_PI_PROVIDER=openai-compatible
# FACTORY_PI_MODEL=operator-model-id
# FACTORY_PI_BASE_URL=https://gateway.example/v1
# FACTORY_PI_API=openai-completions
# FACTORY_PI_AUTHENTICATION=api-key
# FACTORY_PI_API_KEY=
# FACTORY_PI_REASONING_EFFORT=
# FACTORY_PI_MAX_OUTPUT_TOKENS=16384
# Give the agent the images attached to the Jira ticket (png, jpeg, gif, webp). Set true only when
# the model reads images: Pi otherwise swaps every image for a text placeholder. The Claude Code
# runtime has the same switch, FACTORY_CLAUDE_CODE_IMAGES.
# FACTORY_PI_IMAGES=false
# Optional limits for those images: how many (default 10, 0 = no limit) and the largest file in bytes.
# FACTORY_DEV_FACTORY_ATTACHMENT_MAX_IMAGES=10
# FACTORY_DEV_FACTORY_ATTACHMENT_MAX_BYTES=3145728

# Claude Code 2.1.287: operator endpoint must implement Anthropic Messages API.
# FACTORY_DEV_FACTORY_CODING_RUNTIME=claude-code
# FACTORY_CLAUDE_CODE_IMAGE=factory-dev-claude-code:2.1.287-java21-node22
# FACTORY_CLAUDE_CODE_API=anthropic-messages
# Base URL is the prefix before /v1/messages, e.g. a CodeMie Anthropic route.
# This is an illustrative URL; ask your operator for the actual endpoint.
# FACTORY_CLAUDE_CODE_BASE_URL=https://codemie.example/anthropic
# FACTORY_CLAUDE_CODE_MODEL=operator-model-id
# Select exactly how the credential is sent. There is no host Claude login.
# FACTORY_CLAUDE_CODE_AUTHENTICATION=bearer-token
# FACTORY_CLAUDE_CODE_AUTH_TOKEN=
# Or use authentication=api-key with FACTORY_CLAUDE_CODE_API_KEY instead.
# FACTORY_CLAUDE_CODE_API_KEY=
# FACTORY_CLAUDE_CODE_MAX_TURNS=40
# FACTORY_CLAUDE_CODE_MAX_OUTPUT_TOKENS=16384
# FACTORY_CLAUDE_CODE_EFFORT=                 # optional: low, medium, high, max

# Backward-compatible Pi names. Nonblank FACTORY_PI_* values take precedence
# field by field; unset/empty new values fall back to these legacy settings.
# FACTORY_MODEL_PROVIDER=openai-compatible
# FACTORY_MODEL_ID=glm-5.3
# FACTORY_MODEL_BASE_URL=https://api.z.ai/api/coding/paas/v4
# FACTORY_MODEL_API=openai-completions
# FACTORY_MODEL_API_KEY=
# FACTORY_MODEL_REASONING_EFFORT=
# FACTORY_MODEL_MAX_OUTPUT_TOKENS=16384
# FACTORY_DEV_FACTORY_CODING_IMAGE=factory-dev-pi:0.85.1-java21-node22
# Legacy names apply only to Pi, never to Claude Code.
# FACTORY_DEV_FACTORY_TIMEOUT_SECONDS=1800
# FACTORY_DEV_FACTORY_MAVEN_CACHE_VOLUME=factory-dev-m2-cache
# Seconds allowed for copying the shared dependency cache into one coding or verification workload;
# a 3.4 GB yarn cache took about 57 s on the pilot machine.
# FACTORY_DEV_FACTORY_SEED_TIMEOUT_SECONDS=300
# UI (yarn + Jest) plans: trusted yarn cache volume and the registry for @folio/* packages.
# FACTORY_DEV_FACTORY_YARN_CACHE_VOLUME=factory-dev-yarn-cache
# FACTORY_DEV_FACTORY_FOLIO_NPM_REGISTRY=https://repository.folio.org/repository/npm-folioci/
# Host ports bind to loopback by default. Change only on a trusted network.
# FACTORY_BIND_ADDRESS=127.0.0.1

# Source and delivery repositories are configured together under
# factory.dev-factory in factory-app/src/main/resources/application.yaml;
# override any per-repo default with FACTORY_<REPO>_SOURCE_REPO or
# FACTORY_<REPO>_DELIVERY_REPO (for example FACTORY_SIDECAR_SOURCE_REPO).

# FACTORY_CONNECTORS_TESTRAIL_BASE_URL=
# FACTORY_CONNECTORS_TESTRAIL_USERNAME=
# FACTORY_CONNECTORS_TESTRAIL_API_KEY=
# FACTORY_CONNECTORS_TESTRAIL_PROJECT_ID=
# FACTORY_CONNECTORS_TESTRAIL_SUITE_ID=    # required for multi-suite projects; used by get_sections and get_cases

# Outbound HTTP timeouts for the connectors (Durations, e.g. 10s / 500ms).
# FACTORY_HTTP_CONNECT_TIMEOUT=5s
# FACTORY_HTTP_READ_TIMEOUT=30s

# ---------------------------------------------------- Test Factory flow (A)
# FACTORY_TEST_FACTORY_TARGET_REPO=            # owner/repo receiving test scripts
# FACTORY_TEST_FACTORY_BASE_BRANCH=main
# FACTORY_TEST_FACTORY_TESTRAIL_SECTION_ID=
# FACTORY_TEST_FACTORY_JIRA_TRANSITION=

# Both are required to run Karate for real; otherwise execution is advisory.
# FACTORY_TEST_FACTORY_EXECUTION_BASE_URL=
# FACTORY_TEST_FACTORY_EXECUTION_KARATE_JAR=

# --------------------------------------------------- Cypress Factory flow (B)
# GitHub repo that receives generated .cy.js specs (owner/repo format).
# FACTORY_CYPRESS_TARGET_REPO=                   # e.g. folio-org/stripes-testing
# FACTORY_CYPRESS_BASE_BRANCH=main

# GitHub repo (owner/repo) containing the FOLIO AI skills (e.g. your-org/folio-eureka-ai-dev).
# Supplies SKILL.md, references/examples.md and the 29 references/context/{area}.md files.
# Resolved in three tiers: a shallow git clone at {user.dir}/skillsClone (no token needed for a
# public repo), then the GitHub API (this var + FACTORY_CONNECTORS_GITHUB_TOKEN), then copies
# bundled in the jar. Leave unset to clone folio-org/folio-eureka-ai-dev and skip the API tier.
# FACTORY_CYPRESS_FOLIO_AI_REPO=                # e.g. your-org/folio-eureka-ai-dev

# TestRail section (folder) to create new Cypress cases under. Used when the agent's suggested
# section is absent or does not resolve; override per-run by amending testrail_section in
# test_plan.md frontmatter at gate 1.
# FACTORY_CYPRESS_TESTRAIL_SECTION_ID=
# TestRail case type name, resolved against TestRail's own get_case_types at sync time
# (not a hardcoded id - those drift when TestRail is re-templated). Code default: "Functional".
# FACTORY_CYPRESS_TESTRAIL_CASE_TYPE_NAME=
# TestRail priority name, resolved the same way. Code default: "Medium".
# FACTORY_CYPRESS_TESTRAIL_PRIORITY_NAME=
# Label applied to every generated case. Default "cypressFlow-delete".
# Used by scripts/cleanup-cypress-testrail-cases.py to find cases for deletion.
# FACTORY_CYPRESS_TESTRAIL_LABEL=
# Max agent review iterations per testcase-gen run. Default 3. Set to 0 to skip agent review entirely.
# FACTORY_CYPRESS_MAX_REVIEW_ITERATIONS=3
# Send images embedded inline in the story description to the model (default true).
# Set false if FACTORY_LLM_MODEL has no image support.
# Per-request LLM timeout for the cypress flow (default 15m). This OVERRIDES FACTORY_LLM_TIMEOUT
# for this flow - it is applied via AnthropicChatOptions.timeout, which Spring AI uses to build a
# client of its own for the call. Raise it rather than lowering it: a cancelled request is still
# billed for whatever the model already generated.
FACTORY_CYPRESS_LLM_TIMEOUT=
FACTORY_CYPRESS_SEND_IMAGES=
# Jira projects whose tickets are never added to a case's TestRail References field.
# Comma-separated project keys. Default FAT (test/automation work, not product behaviour).
# The originating ticket is always kept even if its project is listed here.
# FACTORY_CYPRESS_REFS_EXCLUDED_PROJECTS=FAT

# ---------------------------------------------------------------------- Debug
# Exposes POST /api/debug/partial-run, which starts an execution at a chosen step with
# pre-seeded artifacts so a late step can be tested without re-running the whole flow.
# The endpoint bean does not exist unless this is true. Never enable in a shared environment.
# FACTORY_DEBUG_ENABLED=false

# --------------------------------------------------------------- Engine tuning
# FACTORY_ENGINE_POLL_INTERVAL_MS=2000
# FACTORY_ENGINE_BATCH_SIZE=5
# FACTORY_ENGINE_WORKER_THREADS=4
# FACTORY_ENGINE_REAP_INTERVAL_MS=30000
# Must exceed the longest legitimate step. For Developer Flow, keep it above twice
# FACTORY_DEV_FACTORY_TIMEOUT_SECONDS plus setup/freezing margin.
# FACTORY_ENGINE_LEASE_TIMEOUT_SECONDS=7200
# FACTORY_ENGINE_SHUTDOWN_AWAIT_SECONDS=30
# SINGLE-INSTANCE ONLY — set false for multi-instance (see doc/runbook.md).
# FACTORY_ENGINE_RECLAIM_RUNNING_ON_STARTUP=true
# FACTORY_SHUTDOWN_PHASE_TIMEOUT=60s

# ------------------------------------------------------------- Cost and limits
# 0 disables a guard. The daily budget answers 429 once exhausted.
# FACTORY_LIMITS_MAX_CONCURRENT_EXECUTIONS=8
# FACTORY_LIMITS_MAX_EXECUTIONS_PER_DAY=200
# FACTORY_LIMITS_MAX_ARTIFACT_BYTES=5000000
# FACTORY_LIMITS_MAX_TRIGGER_PAYLOAD_BYTES=262144
# Re-fires of the same payload within the window collapse onto the first run.
# FACTORY_LIMITS_DEDUP_ENABLED=true
# FACTORY_LIMITS_DEDUP_WINDOW=10m
# FACTORY_LIMITS_DEDUP_ID_POINTERS=/issueKey

# ------------------------------------------------------ Retention and logging
# Destructive, so opt-in: purges terminal execution trees past the TTL.
# The audit log is never purged. Set the cron to "-" to disable the trigger.
# FACTORY_RETENTION_ENABLED=false
# FACTORY_RETENTION_TTL_DAYS=90
# FACTORY_RETENTION_BATCH_SIZE=100
# FACTORY_RETENTION_RUN_CRON=0 30 3 * * *

# Structured JSON logging: ecs, logstash or gelf. Empty keeps it human-readable.
# FACTORY_LOG_FORMAT=
